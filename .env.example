# Copy this file to .env in apps/desktop (or export these in your shell)
# before running `npm run dev`. Never commit a real .env file.

# Google Cloud OAuth client (Desktop app type) used for Gmail + Calendar.
# Create one at https://console.cloud.google.com/apis/credentials
# - Application type: Desktop app
# - Enable the Gmail API and Google Calendar API on the project
# - Add your own Google account as a test user while the app is in "Testing" mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only needed if you want to test the OpenAI extraction provider
# without going through the in-app Settings > AI screen (which stores the
# key in OS-protected storage instead of an env var).
OPENAI_API_KEY=
